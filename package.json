{
  "name": "mobile-browser-integration-live-engine-mobile",
  "version": "1.0.0",
  "description": "Mobile Browser Integration & Live Engine (MOBILE) — Mobile BDD test automation (Cucumber + TypeScript, ESM)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "NODE_OPTIONS='--import tsx' cucumber-js",
    "build": "tsc --noEmit",
    "lint": "eslint 'tests/**/*.ts' && prettier --check 'tests/**/*.ts' 'features/**/*.feature'",
    "format": "prettier --write 'tests/**/*.ts' 'features/**/*.feature' 'src/**/*.ts'"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@faker-js/faker": "^10.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-gherkin": "^3.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0"
}
